# Copy this file to .env for local development or to .env.prod for production.
# Keep real secrets out of git. For production, generate new passwords with:
#   .\scripts\generate_env_secrets.ps1
# or directly:
#   $env:UV_CACHE_DIR=".uv-cache"; uv run python scripts\generate_env_secrets.py
#
# Docker Compose note: if a value contains $, escape each dollar as $$.

# Runtime mode
DEBUG=False
APP_PORT=8000

# Public production domain for nginx and TLS.
DOMAIN_NAME=example.com

# Shared JWT/AuthX signing key. Must be the same for site, backend, and chat.
SECRET_KEY=replace-with-generated-secret
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30
AUTHX_JWT_ALGORITHM=HS256
AUTHX_JWT_TOKEN_LOCATIONS=["headers"]

# Internal site <-> game service authentication.
# BACKEND_INTERNAL_SERVICE_KEY and FRONTEND_INTERNAL_SERVICE_KEY must match.
# SITE_TO_GAME_SERVICE_KEY can use the same value unless you intentionally split keys.
SITE_TO_GAME_SERVICE_KEY=replace-with-generated-service-key
FRONTEND_INTERNAL_SERVICE_KEY=replace-with-generated-internal-service-key
BACKEND_INTERNAL_SERVICE_KEY=replace-with-generated-internal-service-key

# PostgreSQL infra. POSTGRES_PASSWORD must match the password embedded in both URLs.
POSTGRES_USER=tbmmorpg
POSTGRES_PASSWORD=replace-with-generated-postgres-password
POSTGRES_DB=tbmmorpg_site
SITE_DATABASE_URL=postgresql+asyncpg://tbmmorpg:replace-with-generated-postgres-password@postgres:5432/tbmmorpg_site
GAME_DATABASE_URL=postgresql+asyncpg://tbmmorpg:replace-with-generated-postgres-password@postgres:5432/tbmmorpg_game

# Redis infra. REDIS_PASSWORD must match the password embedded in REDIS_URL.
REDIS_PASSWORD=replace-with-generated-redis-password
REDIS_URL=redis://:replace-with-generated-redis-password@redis:6379/0

# Frontend -> backend and browser websocket endpoints.
BACKEND_BASE_URL=http://backend:8001
CHAT_WS_URL=wss://example.com/ws/chat
ACTIVE_CHARACTER_COOKIE_SECURE=True
GAME_TOKEN_COOKIE_SECURE=True

# Email delivery for account flows.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=noreply@example.com
EMAIL_ADMIN=admin@example.com

# AI providers. Copy real API keys as-is from the provider dashboards.
GEMINI_API_KEY=
GEMINI_TOKEN=
OPENROUTER_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_IMAGE_MODEL=gemini-2.5-flash-image
GEMINI_MONSTER_IMAGE_MODEL=gemini-2.5-flash-image
GEMINI_LOCATION_IMAGE_MODEL=gemini-2.5-flash-image
GEMINI_AVATAR_IMAGE_MODEL=gemini-2.5-flash-image

# World/content generation switches.
WORLD_AUTO_GENERATE=False
WORLD_GENERATION_MODE=production

# Generated asset storage. Use local for mounted Docker volume, s3 for object storage.
ASSET_STORAGE_BACKEND=local
ASSET_PUBLIC_BASE_URL=/static/generated-assets
ASSET_LOCAL_ROOT=var/generated-assets
ASSET_S3_BUCKET=
ASSET_S3_REGION=
ASSET_S3_ENDPOINT_URL=
ASSET_S3_ACCESS_KEY_ID=
ASSET_S3_SECRET_ACCESS_KEY=

# Stream/worker identity. Defaults are fine unless running multiple worker groups.
GAME_STREAM_NAME=game_events
GAME_STREAM_MAXLEN=10000
STREAM_CONSUMER_GROUP=monolith
WORKER_NAME=worker_1
CHAT_STREAM_CONSUMER_GROUP=chat
CHAT_WORKER_NAME=chat_worker_1

# Production images. The deploy workflow writes these automatically.
DOCKER_IMAGE_SITE=
DOCKER_IMAGE_GAME=
DOCKER_IMAGE_CHAT=
DOCKER_IMAGE_WORKER=
DOCKER_IMAGE_NGINX=
