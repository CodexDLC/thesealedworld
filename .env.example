# --- Base Infrastructure ---
BOT_TOKEN=your_bot_token_here
SECRET_KEY=tg_bot_secret_salt_12345
DEBUG=True
DOMAIN_NAME=localhost:8000

# --- Service Flags ---
USE_REDIS=true
USE_REDIS_FSM=true
USE_REDIS_STREAMS=true

# --- Redis Configuration ---
# Local dev (no Docker): redis://:dev_redis_password@127.0.0.1:6380/0
# Docker Compose: redis://:dev_redis_password@redis:6379/0
REDIS_PASSWORD=dev_redis_password
REDIS_URL=redis://:dev_redis_password@127.0.0.1:6380/0

# --- Access Control ---
# Comma-separated lists of Telegram IDs
SUPERUSER_IDS=
OWNER_IDS=

# --- API Mode Configuration ---
# Local dev: http://127.0.0.1:8001
# Docker Compose: http://backend:8001
BACKEND_BASE_URL=http://127.0.0.1:8001
BACKEND_API_KEY=
BACKEND_API_TIMEOUT=10.0

# --- Channel Configuration ---
# Telegram ID of the channel where news will be published
TELEGRAM_CHANNEL_ID=your_channel_id_here
