# Production environment template.
# Copy to .env.prod and replace every replace-* value before deployment.
# Keep real secrets out of git.
#
# Generate internal secrets with:
#   .\scripts\generate_env_secrets.ps1
# or:
#   $env:UV_CACHE_DIR=".uv-cache"; uv run python scripts\generate_env_secrets.py
#
# Docker Compose note: if a value contains $, escape each dollar as $$.

# Runtime mode
DEBUG=False
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL_CONSOLE=INFO
LOG_LEVEL_FILE=INFO
LOG_ROTATION=10 MB
LOG_DIR=logs

# Public production domain for nginx and TLS
DOMAIN_NAME=replace-with-production-domain

# Shared JWT/AuthX signing key. Must be identical for site, backend, and chat.
SECRET_KEY=replace-with-generated-secret
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30
AUTHX_JWT_ALGORITHM=HS256
AUTHX_JWT_TOKEN_LOCATIONS=["headers"]
GAME_ACCESS_TOKEN_EXPIRE_MINUTES=15
GAME_REFRESH_TOKEN_EXPIRE_MINUTES=720

# Internal site <-> game service authentication.
# BACKEND_INTERNAL_SERVICE_KEY and FRONTEND_INTERNAL_SERVICE_KEY must match.
SITE_TO_GAME_SERVICE_KEY=replace-with-generated-service-key
FRONTEND_INTERNAL_SERVICE_KEY=replace-with-generated-internal-service-key
BACKEND_INTERNAL_SERVICE_KEY=replace-with-generated-internal-service-key
BACKEND_INTERNAL_SERVICE_HEADER=X-Internal-Service-Key

# PostgreSQL infra. POSTGRES_PASSWORD must match both database URLs.
POSTGRES_USER=tbmmorpg
POSTGRES_PASSWORD=replace-with-generated-postgres-password
POSTGRES_DB=tbmmorpg_site
SITE_DATABASE_URL=postgresql+asyncpg://tbmmorpg:replace-with-generated-postgres-password@postgres:5432/tbmmorpg_site  # pragma: allowlist secret
GAME_DATABASE_URL=postgresql+asyncpg://tbmmorpg:replace-with-generated-postgres-password@postgres:5432/tbmmorpg_game  # pragma: allowlist secret
DATABASE_ECHO=False

# Redis infra. REDIS_PASSWORD must match REDIS_URL.
REDIS_PASSWORD=replace-with-generated-redis-password
REDIS_URL=redis://:replace-with-generated-redis-password@redis:6379/0  # pragma: allowlist secret

# MongoDB analytics/document infra. MONGO_INITDB_* initializes the prod Mongo
# container on first start; MONGO_URL is used by backend/chat/workers.
MONGO_INITDB_ROOT_USERNAME=tbmmorpg_mongo
MONGO_INITDB_ROOT_PASSWORD=replace-with-generated-mongo-password
MONGO_URL=mongodb://tbmmorpg_mongo:replace-with-generated-mongo-password@mongo:27017/tbmmorpg_analytics?authSource=admin  # pragma: allowlist secret
MONGO_DATABASE=tbmmorpg_analytics
MONGO_SERVER_SELECTION_TIMEOUT_MS=5000

# Frontend -> backend and browser websocket endpoints.
# REALTIME_WS_URL is the single browser WebSocket per active player session
# (chat traffic + future player.notice events) served by the chat container
# at /ws/realtime. See docs/planning/tech-debt/realtime/player_realtime_gateway.md.
BACKEND_BASE_URL=http://backend:8001
REALTIME_WS_URL=wss://replace-with-production-domain
ACTIVE_CHARACTER_COOKIE_SECURE=True
GAME_TOKEN_COOKIE_SECURE=True
AUTH_USER_CACHE_TTL_SECONDS=1800

# Email delivery. These are external credentials and are not generated by scripts.
SMTP_HOST=replace-with-smtp-host
SMTP_PORT=587
SMTP_START_TLS=True
SMTP_USER=replace-with-smtp-user
SMTP_PASSWORD=replace-with-smtp-password
EMAIL_FROM=noreply@replace-with-production-domain
EMAIL_ADMIN=admin@replace-with-production-domain

# SEO / analytics
SITE_NAME=The Sealed World
SITE_BASE_URL=https://replace-with-production-domain
SITE_META_TITLE=The Sealed World
SITE_META_DESCRIPTION=Browser-based turn-based MMORPG about dangerous expeditions beyond the wall, loot, and making it home alive.
SITE_META_IMAGE=/static/images/site/the-sealed-world/hero-main.webp
GOOGLE_TAG_MANAGER_ID=
GOOGLE_ANALYTICS_ID=
GOOGLE_SITE_VERIFICATION=

# AI providers. Copy real API keys as-is from provider dashboards.
GEMINI_API_KEY=replace-with-gemini-api-key
GEMINI_TOKEN=
OPENROUTER_API_KEY=replace-with-openrouter-api-key
GEMINI_MODEL=gemini-2.5-flash
GEMINI_IMAGE_MODEL=gemini-2.5-flash-image
GEMINI_MONSTER_IMAGE_MODEL=gemini-2.5-flash-image
GEMINI_LOCATION_IMAGE_MODEL=gemini-2.5-flash-image
GEMINI_AVATAR_IMAGE_MODEL=gemini-2.5-flash-image
MONSTER_CLAN_FLAVOR_AI_INTERVAL_SECONDS=30.0

# World/content generation switches
WORLD_AUTO_GENERATE=False
WORLD_GENERATION_MODE=production
DEFAULT_SYMBIOTE_NAME=SYSTEM

# Generated asset storage. Use local for mounted Docker volume, s3 for object storage.
ASSET_STORAGE_BACKEND=s3
ASSET_PUBLIC_BASE_URL=/static/generated-assets
ASSET_LOCAL_ROOT=var/generated-assets
ASSET_S3_BUCKET=thesealedworld-generated-assets
ASSET_S3_REGION=nbg1
ASSET_S3_ENDPOINT_URL=https://nbg1.your-objectstorage.com
ASSET_S3_ACCESS_KEY_ID=
ASSET_S3_SECRET_ACCESS_KEY=

# Stream/worker identity. Defaults are fine unless running multiple worker groups.
GAME_STREAM_NAME=game_events
GAME_STREAM_MAXLEN=10000
STREAM_CONSUMER_GROUP=monolith
# STREAM_ENABLED_GROUPS=combat,system,generation_ai
WORKER_NAME=worker_1
CHAT_STREAM_CONSUMER_GROUP=chat
CHAT_WORKER_NAME=chat_worker_1
CHAT_BUFFER_MAXLEN=5000
CHAT_HISTORY_TAIL=50

# Production images. The deploy workflow may write these automatically.
DOCKER_IMAGE_SITE=replace-with-site-image
DOCKER_IMAGE_GAME=replace-with-game-image
DOCKER_IMAGE_CHAT=replace-with-chat-image
DOCKER_IMAGE_WORKER=replace-with-worker-image
DOCKER_IMAGE_TG_BOT=replace-with-tg-bot-image
DOCKER_IMAGE_NGINX=replace-with-nginx-image

# Telegram Bot Configuration
BOT_TOKEN=replace-with-telegram-bot-token
TELEGRAM_CHANNEL_ID=replace-with-telegram-channel-id
